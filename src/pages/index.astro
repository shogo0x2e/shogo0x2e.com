---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import WorkCard from "../components/WorkCard.astro";
import SocialLinks from "../components/SocialLinks.astro";
import { currentWork } from "../data/currentWork";

const locale = "en" as const;
const projectEntries = (await getCollection("projects", ({ data }) => !data.draft && data.locale === locale))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const projects = projectEntries.filter(({ data }) => data.tags[0] === "Project");
const writingEntries = await getCollection("writing", ({ data }) => !data.draft && data.locale === locale);
const writing = [...projectEntries.filter(({ data }) => data.tags[0] === "Writing"), ...writingEntries]
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf()).slice(0, 3);
const workHref = (entry: (typeof writing)[number]) => entry.collection === "writing" && entry.data.externalUrl
  ? entry.data.externalUrl
  : `/work/${entry.data.slug}/`;

const formatDate = (date: Date) =>
  new Intl.DateTimeFormat("en-CA", {
    year: "numeric",
    month: "2-digit",
    day: "2-digit",
  }).format(date).replaceAll("-", ".");
const structuredData = {
  "@context": "https://schema.org",
  "@type": "ProfilePage",
  url: "https://shogo0x2e.com/",
  mainEntity: {
    "@type": "Person",
    "@id": "https://shogo0x2e.com/#person",
    name: "Shogo Kitada",
    alternateName: ["北田 章伍", "Shogo Kitada", "Kitapi", "きたぴー", "shogo0x2e"],
    url: "https://shogo0x2e.com/",
    sameAs: [
      "https://github.com/shogo0x2e",
      "https://zenn.dev/shogo0x2e",
      "https://qiita.com/shogo0x2e",
      "https://x.com/shogo0x2e",
      "https://www.linkedin.com/in/shogo-kitada-a79683303/",
      "https://www.facebook.com/shogo0x2e/?locale=ja_JP",
    ],
  },
};
---

<BaseLayout
  current="about"
  title="Shogo Kitada (Kitapi) — shogo0x2e"
  description="Shogo Kitada (Kitapi)'s personal technical portfolio."
  structuredData={structuredData}
>
  <main id="main">
    <section class="hero shell section-anchor" id="now" aria-labelledby="hero-title">
      <div class="hero-copy">
        <h1 id="hero-title">Shogo Kitada<span class="hero-name-ja" lang="ja">北田 章伍</span></h1>
        <p class="hero-lede">Software, research, and interactive systems.<br />Based in Japan.</p>
        <div class="identity" aria-label="Profile summary">
          <p>shogo0x2e / Kitapi</p>
        </div>
        <SocialLinks locale={locale} />
      </div>
      <figure class="hero-figure">
        <img
          src="/images/hero-google-japan.webp"
          alt="Shogo Kitada at Google Japan"
          width="1200"
          height="1200"
        />
      </figure>
    </section>

    <section class="current-work shell section-anchor" aria-labelledby="current-title">
          <div class="current-copy">
            <p class="eyebrow">{currentWork.en.eyebrow}</p>
            <h2 id="current-title">{currentWork.en.title}</h2>
            <p class="current-summary">{currentWork.en.description}</p>
            <p class="contribution"><strong>Keyword:</strong> {currentWork.en.role}</p>
            <div class="current-links">
              <a href={`/work/${currentWork.slug}/`}>View project <span aria-hidden="true">→</span></a>
              <a href={currentWork.paperUrl}>Read paper <span aria-hidden="true">↗</span></a>
            </div>
          </div>
          <div class="current-gallery" aria-label="Robotic Telepresence project images">
            <img src={currentWork.images[0]} alt="A participant interacting with a projected remote speaker across modular robot bodies" width="288" height="180" />
            <img src={currentWork.images[1]} alt="Comparison of two projection arrangements for representing a remote speaker's body" width="308" height="180" />
            <img src={currentWork.images[2]} alt="Robotic Telepresence system configuration with robots, cameras, projector, and reflective floor" width="290" height="180" />
          </div>
    </section>

    <div class="content-grid shell">
      <section class="project-list" aria-labelledby="projects-title">
        <div class="section-heading">
          <h2 id="projects-title">Projects</h2>
          <a href="/work/?type=project">View all projects <span aria-hidden="true">→</span></a>
        </div>
        <div class="project-grid">
          {projects.filter(({ data }) => data.slug !== currentWork.slug).slice(0, 3).map((project) => (
            <WorkCard work={project} locale={locale} showType={false} showDate={false} />
          ))}
        </div>
      </section>

      <section class="writing section-anchor" aria-labelledby="writing-title">
        <div class="section-heading">
          <h2 id="writing-title">Writing</h2>
          <a href="/work/?type=writing">View all writing <span aria-hidden="true">→</span></a>
        </div>
        <ol class="writing-list">
          {writing.map((entry) => (
            <li>
              <time datetime={entry.data.date.toISOString()}>{formatDate(entry.data.date)}</time>
              <div>
                <a href={workHref(entry)}>{entry.data.title}</a>
              </div>
            </li>
          ))}
        </ol>
      </section>
    </div>
  </main>
</BaseLayout>
