      <p>For opportunities, collaborations, or questions:</p>
      <a class="email-link" href="mailto:contact@shogo0x2e.com">
        contact@shogo0x2e.com <span aria-hidden="true">↗</span>
      </a>
    </div>
  </main>
</BaseLayout>
