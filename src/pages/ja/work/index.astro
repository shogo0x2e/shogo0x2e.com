---
import { getCollection } from "astro:content";
import BaseLayout from "../../../layouts/BaseLayout.astro";
import WorkCard from "../../../components/WorkCard.astro";

const locale = "ja" as const;
const projects = await getCollection("projects", ({ data }) => !data.draft && data.locale === locale);
const writing = await getCollection("writing", ({ data }) => !data.draft && data.locale === locale);
const work = [...projects, ...writing].sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const filters = [{ label: "すべて", value: "all" }, { label: "Project", value: "project" }, { label: "Writing", value: "writing" }];
---

<BaseLayout locale={locale} title="Work — shogo0x2e" description="北田章伍のプロジェクトと執筆．" current="work">
  <main class="archive shell" id="main">
    <header class="page-intro"><h1>Work</h1><p>ソフトウェア，研究，インタラクティブシステムに関するプロジェクトと執筆．</p></header>
    <section class="archive-controls" aria-label="Workの検索と絞り込み">
      <label class="search-field"><span class="visually-hidden">Workを検索</span><input type="search" placeholder="Workを検索" autocomplete="off" data-work-search /></label>
      <div class="filter-row">
        <div class="filter-list" aria-label="種類で絞り込む">{filters.map((filter) => <button type="button" aria-pressed={filter.value === "all" ? "true" : "false"} data-filter={filter.value}>{filter.label}</button>)}</div>
        <p class="result-count" aria-live="polite" data-result-count>{work.length}件</p>
      </div>
    </section>
    <section class="archive-grid" aria-label="Work一覧" data-work-grid>{work.map((entry, index) => <WorkCard work={entry} locale={locale} loading={index === 0 ? "eager" : "lazy"} />)}</section>
    <p class="empty-state" hidden data-empty-state>条件に一致するWorkがありません．</p>
  </main>
</BaseLayout>

<script>
  const search = document.querySelector<HTMLInputElement>("[data-work-search]");
  const buttons = [...document.querySelectorAll<HTMLButtonElement>("[data-filter]")];
  const cards = [...document.querySelectorAll<HTMLElement>("[data-work-card]")];
  const count = document.querySelector<HTMLElement>("[data-result-count]");
  const empty = document.querySelector<HTMLElement>("[data-empty-state]");
  const params = new URLSearchParams(window.location.search);
  let activeFilter = ["project", "writing"].includes(params.get("type") ?? "") ? params.get("type")! : "all";
  if (search) search.value = params.get("q") ?? "";
  const normalize = (value: string) => value.trim().toLocaleLowerCase();
  function updateUrl() {
    const next = new URLSearchParams(window.location.search);
    const query = search?.value.trim() ?? "";
    query ? next.set("q", query) : next.delete("q");
    activeFilter === "all" ? next.delete("type") : next.set("type", activeFilter);
    const suffix = next.toString();
    history.replaceState(null, "", `${window.location.pathname}${suffix ? `?${suffix}` : ""}`);
  }
  function updateResults(syncUrl = true) {
    const query = normalize(search?.value ?? "");
    let visible = 0;
    cards.forEach((card) => {
      const matchesType = activeFilter === "all" || card.dataset.type === activeFilter;
      const matchesQuery = !query || normalize(card.dataset.search ?? "").includes(query);
      card.hidden = !(matchesType && matchesQuery);
      if (!card.hidden) visible += 1;
    });
    buttons.forEach((button) => button.setAttribute("aria-pressed", String(button.dataset.filter === activeFilter)));
    if (count) count.textContent = `${visible}件`;
    if (empty) empty.hidden = visible !== 0;
    if (syncUrl) updateUrl();
  }
  search?.addEventListener("input", () => updateResults());
  buttons.forEach((button) => button.addEventListener("click", () => { activeFilter = button.dataset.filter ?? "all"; updateResults(); }));
  updateResults(false);
</script>
