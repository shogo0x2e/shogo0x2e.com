---
import { getCollection, render } from "astro:content";
import BaseLayout from "../../../layouts/BaseLayout.astro";
import ResponsiveImage from "../../../components/ResponsiveImage.astro";

export async function getStaticPaths() {
  const projects = await getCollection("projects", ({ data }) => !data.draft && data.locale === "ja");
  return projects.map((work) => ({ params: { id: work.data.slug }, props: { work } }));
}
const { work } = Astro.props;
const { Content } = await render(work);
const hasLinks = work.data.repositoryUrl || work.data.paperUrl || work.data.sourceUrl;
---

<BaseLayout locale="ja" title={`${work.data.title} — shogo0x2e`} description={work.data.description} current="work">
  <main class="detail-page shell" id="main">
    <a class="back-link" href="/ja/work/">← すべてのWork</a>
    <header class="detail-header"><p class="eyebrow">{work.data.date.toISOString().slice(0, 7).replace("-", ".")} · {work.data.tags[0]}</p><h1>{work.data.title}</h1><p>{work.data.description}</p></header>
    {work.data.hero && <ResponsiveImage class="detail-hero" src={work.data.hero} alt="" width={1400} height={700} sizes="100vw" loading="eager" />}
    <div class="detail-grid">
      <aside>
        <dl class="detail-meta">{work.data.role && <div><dt>Keyword:</dt><dd>{work.data.role}</dd></div>}<div><dt>年</dt><dd>{work.data.year}</dd></div></dl>
      </aside>
      <article class="prose">
        {work.data.video && <figure class="detail-video"><video controls playsinline preload="metadata" poster={work.data.hero}><source src={work.data.video} type="video/mp4" />お使いのブラウザは動画再生に対応していません．</video><figcaption>展示記録</figcaption></figure>}
        {work.data.youtubeId && <figure class="detail-video"><iframe src={`https://www.youtube-nocookie.com/embed/${work.data.youtubeId}`} title={`${work.data.title}の動画`} loading="lazy" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share" allowfullscreen></iframe><figcaption>プロジェクト動画</figcaption></figure>}
        <Content />
        {hasLinks && (
          <section class="project-resource-links">
            <h2>関連リンク</h2>
            <ul>
              {work.data.repositoryUrl && <li><a href={work.data.repositoryUrl}>GitHubリポジトリ ↗</a></li>}
              {work.data.paperUrl && <li><a href={work.data.paperUrl}>論文を読む ↗</a></li>}
              {work.data.sourceUrl && <li><a href={work.data.sourceUrl}>関連資料 ↗</a></li>}
            </ul>
          </section>
        )}
      </article>
    </div>
  </main>
</BaseLayout>
