---
// Reusable responsive image for public/ assets. WebP derivatives generated by
// scripts/generate-responsive-images.mjs are offered via <picture> sources;
// only widths recorded in the generated manifest are referenced, and the
// original file remains the <img> fallback.
import { responsiveWidths } from "../generated/responsiveImages";

interface Props {
  src: string;
  alt: string;
  width?: number;
  height?: number;
  sizes?: string;
  loading?: "eager" | "lazy";
  fetchpriority?: "high" | "low" | "auto";
  class?: string;
  style?: string;
}

const {
  src,
  alt,
  width,
  height,
  sizes = "100vw",
  loading = "lazy",
  fetchpriority = "auto",
  class: className,
  style,
} = Astro.props;

const stem = src.replace(/^\/images\//, "/images/responsive/").replace(/\.[^.]+$/, "");
const widths = responsiveWidths[src] ?? [];
const srcset = widths.map((w) => `${stem}-${w}.webp ${w}w`).join(", ");
---

<picture>
  {srcset && <source type="image/webp" srcset={srcset} sizes={sizes} />}
  <img
    src={src}
    alt={alt}
    width={width}
    height={height}
    loading={loading}
    fetchpriority={fetchpriority}
    class={className}
    style={style}
  />
</picture>
