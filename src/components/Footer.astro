---
import { buildMetadata } from "../generated/buildMetadata";

interface Props {
  compact?: boolean;
  locale?: "en" | "ja";
}
const { compact = false, locale = "en" } = Astro.props;
const lastUpdated = new Date(buildMetadata.lastUpdated);
const lastUpdatedIso = lastUpdated.toISOString();
const lastUpdatedLabel = `${lastUpdatedIso.slice(0, 16)}Z`;
---

<footer class="site-footer shell">
  <p>© 2026 Shogo Kitada</p>
  <p><time datetime={lastUpdatedIso}>Last updated {lastUpdatedLabel}</time></p>
  {
    !compact && (
      <nav aria-label={locale === "ja" ? "外部リンク" : "Social links"}>
        <a href="mailto:contact@shogo0x2e.com">contact@shogo0x2e.com</a>
      </nav>
    )
  }
</footer>
